{
  "name": "@ondc-website/api-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Express API server for ONDC website with direct SDK integration",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@ondc-agent/seller-sdk": "workspace:*",
    "@ondc-agent/shared": "workspace:*",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "tsup": "^8.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
