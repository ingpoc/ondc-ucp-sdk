{
  "name": "ondc-agent-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "MCP-first gateway bridging AI agents with ONDC network",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint packages/*/src --ext .ts",
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm --filter @ondc-agent/gateway dev",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "postinstall": "node ./.claude/scripts/fix-symlinks.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "supertest": "^7.2.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.2",
    "@types/express": "^5.0.6",
    "express": "^5.2.1"
  },
  "pnpm": {
    "overrides": {
      "libsodium-wrappers": "^0.8.0"
    }
  }
}
